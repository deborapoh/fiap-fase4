# Modelo de configuracao. Copie para .env e preencha os valores.
#   cp .env.example .env
# O arquivo .env esta no .gitignore e nunca deve ser commitado.

# --- Hugging Face (camada gerenciada em nuvem) ---
# Gere em https://huggingface.co/settings/tokens com permissao de escrita
HF_TOKEN=

# Usuario/organizacao onde o Space de demonstracao sera publicado
HF_USERNAME=

# --- Cache de modelos ---
# Mantem os pesos baixados (Whisper, transformers) fora do versionamento
HF_HOME=./models/hf

# --- Transcricao de audio ---
# Opcoes: tiny, base, small, medium, large-v3
WHISPER_MODEL=large-v3
# Opcoes: auto, cpu, cuda
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=en

# --- Caminhos de dados ---
DATA_RAW=./data/raw
DATA_PROCESSED=./data/processed
